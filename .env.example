# .env.example — copy to .env and fill in real values
# NEVER commit the real .env file to Git

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=shopsignal-ml
GCP_REGION=australia-southeast1
GCP_DATASET=shopsignal

# ── BigQuery ──────────────────────────────────────────────────────────────────
BQ_LOCATION=australia-southeast1

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO

# ── dbt ───────────────────────────────────────────────────────────────────────
# Copy dbt/profiles.yml.example → dbt/profiles.yml and set credentials there.

# ── MLflow (optional) ─────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_EXPERIMENT_NAME=shopsignal-ranker

# ── Data loading ──────────────────────────────────────────────────────────────
# SHOPSIGNAL_TX_ROWS controls how many rows are loaded from transactions_train.csv
# (always the latest N rows, which are the most recent transactions).
#
# Preset guide:
#   2_000_000   fast dev   ~0.4 GB RAM  52 days   ~47% cold-start users (auto-split)
#   15_000_000  modelling  ~4.7 GB RAM  12 months ~15-16% cold-start users
#
# Default is 2_000_000. Override for deeper training history:
# SHOPSIGNAL_TX_ROWS=15_000_000

# ── Temporal split ────────────────────────────────────────────────────────────
# Cutoffs for make_temporal_split(). Defaults work for the full 31M-row dataset.
# When loading a subset whose date range starts after these dates, the function
# auto-derives proportional cutoffs (75% / 87.5% of the loaded date range).
# SHOPSIGNAL_VAL_START=2020-07-01
# SHOPSIGNAL_TEST_START=2020-08-12

# ── Model thresholds ──────────────────────────────────────────────────────────
NDCG_PROMOTION_THRESHOLD=0.35
